{
  "name": "otakuclaw-desktop",
  "version": "0.2.2",
  "description": "OtakuClaw desktop application.",
  "author": "OtakuClaw",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "main": "desktop/electron/main.js",
  "scripts": {
    "frontend:dev": "pnpm --dir front_end run dev --host 127.0.0.1 --port 3000 --strictPort",
    "frontend:build": "pnpm --dir front_end run build",
    "frontend:dev:web": "pnpm --dir front_end run dev",
    "frontend:build:web": "node scripts/build-web.js",
    "frontend:preview:web": "pnpm --dir front_end run preview --port 4173",
    "desktop:dev:renderer": "pnpm run frontend:dev",
    "desktop:dev:electron": "node desktop/electron/scripts/waitForDevServer.js && cross-env ELECTRON_DEV_SERVER_URL=http://127.0.0.1:3000 electron .",
    "desktop:dev": "concurrently -k \"pnpm run desktop:dev:renderer\" \"pnpm run desktop:dev:electron\"",
    "desktop:build": "pnpm run frontend:build && electron-builder",
    "desktop:build:mac": "pnpm run frontend:build && electron-builder --mac",
    "desktop:build:win": "pnpm run frontend:build && electron-builder --win --x64",
    "test:frontend": "pnpm --dir front_end exec vitest --run",
    "test:desktop": "node --test desktop/electron/tests/*.test.js",
    "android:build": "pnpm run frontend:build && cap build android",
    "android:dev": "concurrently -k \"pnpm run frontend:dev\" \"cap run android\"",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0",
    "sherpa-onnx-node": "^1.12.28"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "keytar",
      "protobufjs"
    ]
  },
  "build": {
    "appId": "com.otakuclaw.desktop",
    "productName": "OtakuClaw",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "desktop/electron/services/**/*.py"
    ],
    "files": [
      "desktop/electron/**/*",
      "front_end/dist/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "desktop/electron/assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OtakuClaw",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "desktop/electron/assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "desktop/electron/entitlements.mac.plist",
      "entitlementsInherit": "desktop/electron/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "需要麦克风权限来进行语音输入与语音对话。"
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/app": "^8.1.0",
    "electron-updater": "^6.8.3",
    "recharts": "^3.8.1",
    "ws": "^8.19.0"
  }
}

{
  "appId": "com.otakuclaw.scenicguide",
  "appName": "灵山胜境AI导游",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "",
      "keystoreAlias": ""
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#f5f9ff",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "Camera": {
      "permissions": ["camera"]
    },
    "Microphone": {
      "permissions": ["microphone"]
    }
  }
}
